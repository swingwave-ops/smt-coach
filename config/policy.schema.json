{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/smt-coach/policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stale_after_seconds", "providers", "roles"],
  "properties": {
    "schema_version": {"const": 1},
    "stale_after_seconds": {"type": "integer", "minimum": 60, "maximum": 3600},
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "allowed_sources"],
        "properties": {
          "enabled": {"type": "boolean"},
          "allowed_sources": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "enum": ["oauth", "grok-web"]}
          }
        }
      },
      "propertyNames": {"enum": ["codex", "claude", "grok"]}
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": {"$ref": "#/$defs/actionRole"},
        "implementation": {"$ref": "#/$defs/actionRole"},
        "verification": {"$ref": "#/$defs/actionRole"},
        "research": {"$ref": "#/$defs/actionRole"},
        "secondary_audit": {"$ref": "#/$defs/actionRole"}
      }
    }
  },
  "$defs": {
    "requires": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["5h", "7d", "credits"]}
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "requires"],
      "properties": {
        "provider": {"type": "string", "enum": ["codex", "claude", "grok"]},
        "model": {"type": "string", "minLength": 1, "maxLength": 128},
        "requires": {"$ref": "#/$defs/requires"},
        "min_left_pct": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "actionRole": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"const": false},
            "disabled_reason": {"const": "policy_required"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "provider", "model", "requires"],
          "properties": {
            "enabled": {"const": true},
            "provider": {"type": "string", "enum": ["codex", "claude", "grok"]},
            "model": {"type": "string", "minLength": 1, "maxLength": 128},
            "requires": {"$ref": "#/$defs/requires"},
            "min_left_pct": {"type": "number", "minimum": 0, "maximum": 100}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "candidates"],
          "properties": {
            "enabled": {"const": true},
            "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
            "switch_margin_pct": {"type": "number", "minimum": 0, "maximum": 100}
          }
        }
      ]
    }
  }
}
